// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
    "name": "ubuntu-embedded-arm-gcc-devcontainer",
    "image": "ubuntu-embedded-arm-gcc:1.0",
    "privileged": true,
    "runArgs": ["--name", "${localWorkspaceFolderBasename}", "--net", "host"],

    // Serve per installare l'estensione nel container
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "cschlosser.doxdocgen"            
            ]            
        }
    }
}