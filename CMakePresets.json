{  
  "version": 5,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "/workspaces/${workspaceFolderBasename}/build/${presetName}",      
      "toolchainFile": "/workspaces/${workspaceFolderBasename}/arm-none-eabi-toolchain.cmake",      
      "cacheVariables": {
      "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Spy",
      "inherits": "default",
      "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Spy"
      }
    }
  ]
}